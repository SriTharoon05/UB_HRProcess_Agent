  "HR_USERNAME": "REPLACE_WITH_COMPANY_APPROVED_HR_USERNAME",
  "HR_PASSWORD": "@Microsoft.KeyVault(SecretUri=https://YOUR_VAULT.vault.azure.net/secrets/hr-password/)",
  "METADATA_BACKEND": "postgres",
  "DATABASE_URL": "@Microsoft.KeyVault(SecretUri=https://YOUR_VAULT.vault.azure.net/secrets/database-url/)",
  "DATABASE_SSLMODE": "verify-full",
  "DATABASE_SSLROOTCERT": "",
  "DATABASE_CONNECT_TIMEOUT": "10",
