  "CORS_ALLOWED_ORIGINS": "[\"https://YOUR_ACTUAL_APP_HOST\"]",
  "LINKEDIN_REDIRECT_URI": "https://YOUR_ACTUAL_APP_HOST/auth/linkedin/callback",
  "LINKEDIN_CLIENT_ID": "REPLACE_WITH_COMPANY_LINKEDIN_CLIENT_ID",
