/// <summary>
/// Validated evaluation values. A real zero score remains zero.
/// Evidence members hold JSON arrays; they are not double-serialized DTO objects.
/// </summary>
[DataContractAttribute]
public final class UBHRPortalEvaluationContract
{
    int score;
    boolean meetsMinimumCriteria;
    str matchLabel;
    str scoreJustification;
    str summary;
    str matchedSkillsJson;
    str partiallyMatchedJson;
    str missingSkillsJson;
    str evidenceJson;
    str evaluationConfidence;
    str modelDeployment;
    str promptVersion;
    str rubricVersion;

    public void new()
    {
        matchedSkillsJson = "[]";
        partiallyMatchedJson = "[]";
        missingSkillsJson = "[]";
        evidenceJson = "[]";
    }

    [DataMemberAttribute("Score")]
    public int parmScore(int _score = score)
    {
        score = _score;
        return score;
    }

    [DataMemberAttribute("MeetsMinimumCriteria")]
    public boolean parmMeetsMinimumCriteria(boolean _meetsMinimumCriteria = meetsMinimumCriteria)
    {
        meetsMinimumCriteria = _meetsMinimumCriteria;
        return meetsMinimumCriteria;
    }

    [DataMemberAttribute("MatchLabel")]
    public str parmMatchLabel(str _matchLabel = matchLabel)
    {
        matchLabel = _matchLabel;
        return matchLabel;
    }

    [DataMemberAttribute("ScoreJustification")]
    public str parmScoreJustification(str _scoreJustification = scoreJustification)
    {
        scoreJustification = _scoreJustification;
        return scoreJustification;
    }

    [DataMemberAttribute("Summary")]
    public str parmSummary(str _summary = summary)
    {
        summary = _summary;
        return summary;
    }

    [DataMemberAttribute("MatchedSkillsJson")]
    public str parmMatchedSkillsJson(str _matchedSkillsJson = matchedSkillsJson)
    {
        matchedSkillsJson = _matchedSkillsJson;
        return matchedSkillsJson;
    }

    [DataMemberAttribute("PartiallyMatchedJson")]
    public str parmPartiallyMatchedJson(str _partiallyMatchedJson = partiallyMatchedJson)
    {
        partiallyMatchedJson = _partiallyMatchedJson;
        return partiallyMatchedJson;
    }

    [DataMemberAttribute("MissingSkillsJson")]
    public str parmMissingSkillsJson(str _missingSkillsJson = missingSkillsJson)
    {
        missingSkillsJson = _missingSkillsJson;
        return missingSkillsJson;
    }

    [DataMemberAttribute("EvidenceJson")]
    public str parmEvidenceJson(str _evidenceJson = evidenceJson)
    {
        evidenceJson = _evidenceJson;
        return evidenceJson;
    }

    [DataMemberAttribute("EvaluationConfidence")]
    public str parmEvaluationConfidence(str _evaluationConfidence = evaluationConfidence)
    {
        evaluationConfidence = _evaluationConfidence;
        return evaluationConfidence;
    }

    [DataMemberAttribute("ModelDeployment")]
    public str parmModelDeployment(str _modelDeployment = modelDeployment)
    {
        modelDeployment = _modelDeployment;
        return modelDeployment;
    }

    [DataMemberAttribute("PromptVersion")]
    public str parmPromptVersion(str _promptVersion = promptVersion)
    {
        promptVersion = _promptVersion;
        return promptVersion;
    }

    [DataMemberAttribute("RubricVersion")]
    public str parmRubricVersion(str _rubricVersion = rubricVersion)
    {
        rubricVersion = _rubricVersion;
        return rubricVersion;
    }
}
