/// <summary>
/// JSON array wrapper. Empty results serialize as an empty array.
/// </summary>
[DataContractAttribute]
public final class UBHRPortalApplicationsContract
{
    List applications;

    public void new()
    {
        applications = new List(Types::Class);
    }

    [DataMemberAttribute("Applications"),
     DataCollectionAttribute(Types::Class, classStr(UBHRPortalApplicationContract)),
     AifCollectionTypeAttribute("_applications", Types::Class, classStr(UBHRPortalApplicationContract)),
     AifCollectionTypeAttribute("return", Types::Class, classStr(UBHRPortalApplicationContract))]
    public List parmApplications(List _applications = applications)
    {
        applications = _applications;
        return applications;
    }
}
