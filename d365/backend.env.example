# Merge into ignored backend/.env AFTER the three F&O operations are built/deployed.
# React never receives these credentials or calls these endpoints directly.
APP_ENV=development
DEMO_MODE=false
D365_ENABLED=true
D365_CONTRACT_MODE=sqlite
# API and worker must resolve to the SAME durable local file. Use an absolute path
# in a deployed service, e.g. /var/lib/talentmatch/talentmatch.sqlite3.
SQLITE_DATABASE_PATH=.local/talentmatch.sqlite3

D365_BASE_URL=https://<your-fo-host>
D365_TENANT_ID=<your-directory-tenant-id>
D365_CLIENT_ID=<your-server-to-server-application-id>
D365_CLIENT_SECRET=<secret-value>
D365_COMPANY=<integration-users-startup-company>
D365_PARAMETER_NAME=_request
D365_REQUIREMENT_PATH=/api/services/UBHRPortalServiceGroup/UBHRPortalService/getOpenRequirements
D365_SUBMIT_APPLICATION_PATH=/api/services/UBHRPortalServiceGroup/UBHRPortalService/submitApplication
D365_SAVE_EVALUATION_PATH=/api/services/UBHRPortalServiceGroup/UBHRPortalService/saveCandidateEvaluation
D365_REQUEST_WRAPPERS={"get_open_requirements":""}
D365_REQUEST_FIELD_MAPS={}
D365_RESPONSE_FIELD_MAPS={}
D365_HTTP_TIMEOUT=30

# sqlite mode reads history/ranking/detail locally; no F&O paths are required.
D365_TOP_CANDIDATES_PATH=
D365_MY_APPLICATIONS_PATH=
D365_APPLICATION_PATH=

# Keep the user's registered LinkedIn HTTPS callback exact.
BACKEND_BASE_URL=https://localhost:7242
FRONTEND_BASE_URL=http://localhost:5173
LINKEDIN_REDIRECT_URI=https://localhost:7242/auth/linkedin/callback
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# Keep existing LinkedIn, HR Entra, Redis, private Blob and Azure OpenAI settings.
