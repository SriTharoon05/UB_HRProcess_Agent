# Safe local fictional demonstration. Production must explicitly set false.
APP_NAME=TalentMatch AI
APP_ENV=development
DEMO_MODE=true
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
# Lists/maps use JSON. Use exact HTTPS origins in production.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SESSION_COOKIE_NAME=talentmatch_session
SESSION_TTL_SECONDS=28800
CONSENT_VERSION=v1
PUBLIC_RATE_LIMIT=120
UPLOAD_RATE_LIMIT=10

# Opaque server-side sessions and durable queue. Enable Redis AOF and private networking.
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=talentmatch
EVALUATION_MAX_ATTEMPTS=5

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
LINKEDIN_ISSUER=https://www.linkedin.com/oauth
LINKEDIN_DISCOVERY_URL=https://www.linkedin.com/oauth/.well-known/openid-configuration
# Required OIDC scopes are fixed: openid profile email.
HR_ENTRA_TENANT_ID=
HR_ENTRA_CLIENT_ID=
HR_ENTRA_CLIENT_SECRET=
HR_ENTRA_REDIRECT_URI=http://localhost:8000/auth/hr/callback
HR_ALLOWED_ROLES=["HRRecruiter","HRAdministrator"]
ENTRA_HR_ROLE=TalentMatch.HR

D365_ENABLED=false
D365_BASE_URL=https://org1a43c536.operations.dynamics.com
D365_TENANT_ID=
D365_CLIENT_ID=
D365_CLIENT_SECRET=
D365_COMPANY=DAT
D365_PARAMETER_NAME=_request
D365_REQUIREMENT_PATH=/api/services/UBHRApplicationServiceGroup/UBHRApplicationService/getOpenRequirements
D365_SUBMIT_APPLICATION_PATH=/api/services/UBHRApplicationServiceGroup/UBHRApplicationService/submitApplication
# Pending X++ deployment; never filled with fabricated success endpoints.
D365_SAVE_EVALUATION_PATH=
D365_TOP_CANDIDATES_PATH=
# Additional reads for candidate history and own detail. HR can use the top-candidate contract.
D365_MY_APPLICATIONS_PATH=
D365_APPLICATION_PATH=
D365_HTTP_TIMEOUT=30
D365_REQUEST_WRAPPERS={"get_open_requirements":""}
D365_REQUEST_FIELD_MAPS={}
D365_RESPONSE_FIELD_MAPS={}

AZURE_OPENAI_ENDPOINT=https://voiceagentdemo-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_PROMPT_VERSION=v1
AZURE_OPENAI_MAX_RESUME_CHARS=100000

# Pre-provision a private container; production disallows local storage.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=resumes
LOCAL_RESUME_DIR=.local/resumes
MAX_RESUME_SIZE_MB=10
MAX_RESUME_UNCOMPRESSED_MB=40
# Redis temporary processing state expires after this period. D365 and Blob
# lifecycle/deletion require an operator-approved policy, documented in README.
RETENTION_DAYS=90
